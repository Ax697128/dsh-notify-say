{
  "name": "dsh-notify-say",
  "version": "0.5.2",
  "description": "Desktop notifications for DSH Desktop that actually speak: Windows TTS out of the box (zero download), VOICEVOX voice packs optional, a selectable system-sound fallback, and an idle gate that waits for running subagents before saying the turn is done. Includes a settings-page GUI (sound source, per-event overrides, jump-back-to-session, cooldowns) and a self hot-reload for development.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unifilitence/dsh-notify-say.git"
  },
  "homepage": "https://github.com/unifilitence/dsh-notify-say#readme",
  "bugs": {
    "url": "https://github.com/unifilitence/dsh-notify-say/issues"
  },
  "author": "unifilitence",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "sounds",
    "dsh-notify.ps1",
    "tts-speak.ps1",
    "jump-handler.vbs",
    "jump-handler.ps1",
    "cordis.patch.yml",
    "tools",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    ".gitattributes",
    "CHANGELOG.md",
    "test"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "notification",
    "notify",
    "toast",
    "speech",
    "voice",
    "tts",
    "voicevox",
    "desktop",
    "windows",
    "zh"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test",
    "test:all": "node --test && node --import ./test/route-loader-register.mjs --test test/fail-route.test.mjs test/audio-wiring.test.mjs",
    "test:route": "node --import ./test/route-loader-register.mjs --test test/fail-route.test.mjs",
    "test:audio-wire": "node --import ./test/route-loader-register.mjs --test test/audio-wiring.test.mjs",
    "check:client": "node ./test/client-bundle.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
