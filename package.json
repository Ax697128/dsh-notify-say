{
    "name":  "dsh-notify-say",
    "version":  "0.4.21",
    "description":  "Desktop notifications for DSH Desktop that actually speak: Windows TTS out of the box (zero download), VOICEVOX voice packs optional, a selectable system-sound fallback, and an idle gate that waits for running subagents before saying the turn is done. Includes a settings-page GUI (sound source, per-event overrides, jump-back-to-session, cooldowns) and a self hot-reload for development.",
    "license":  "MIT",
    "type":  "module",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/unifilitence/dsh-notify-say.git"
                   },
    "homepage":  "https://github.com/unifilitence/dsh-notify-say#readme",
    "bugs":  {
                 "url":  "https://github.com/unifilitence/dsh-notify-say/issues"
             },
    "author":  "unifilitence",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json",
                    "./locale/*.json":  "./locale/*.json"
                },
    "files":  [
                  "lib",
                  "locale",
                  "sounds",
                  "dsh-notify.ps1",
                  "tts-speak.ps1",
                  "cordis.patch.yml",
                  "tools",
                  "README.md",
                  "LICENSE",
                  "THIRD-PARTY-NOTICES.md"
              ],
    "keywords":  [
                     "dsh",
                     "deepseek-harness",
                     "plugin",
                     "notification",
                     "toast",
                     "voice",
                     "tts",
                     "voicevox",
                     "desktop",
                     "windows"
                 ],
    "engines":  {
                    "node":  "\u003e=20",
                    "dsh":  "\u003e=0.1.7-rc.2"
                },
    "dsh":  {
                "manifestVersion":  1,
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [

                                          ]
                           }
            }
}
